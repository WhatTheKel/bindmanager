# Copy to .env.node on each nameserver host deploying docker-compose.node.yml
# (a different file/host per NameServer row — the API key is what scopes
# which zones this particular node receives).
#
# Use this file/compose pair only on a fresh host with no BIND9 installed
# yet — this container brings its own. If the host already runs BIND9, use
# docker-compose.agent.yml + .env.agent.example instead (containerizes only
# the agent; see docker/bind9-agent/README.md).

# Base URL of BindManager's REST API (no trailing slash)
BINDMANAGER_API_URL=https://your-app-host/api/v1

# From Manage > Nameservers in the BindManager UI (or Django admin) for the
# NameServer row that represents THIS node. Treat like a password.
BINDMANAGER_API_KEY=REPLACE_ME

# Seconds between pulls
BINDMANAGER_POLL_INTERVAL=120
