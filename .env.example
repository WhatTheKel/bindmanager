# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:81

# ── Database engine ────────────────────────────────────────────────────────────
# Set DB_ENGINE to either 'mysql' or 'postgresql'
DB_ENGINE=mysql

# Shared connection details (used by both engines)
DB_NAME=bindmanager
DB_USER=bindmanager
DB_PASSWORD=bindmanager

# Use host.docker.internal to reach a service running on the VM host from inside
# a container, or replace with the actual IP if DB is on a separate machine.
DB_HOST=host.docker.internal

# Port defaults: MySQL = 3306, PostgreSQL = 5432
# Only set DB_PORT here if you're using a non-standard port.
# DB_PORT=3306

# ── MySQL-specific setup (when DB_ENGINE=mysql) ────────────────────────────────
# Run once before first `docker compose up`:
#   mysql -u root -p < docker/mysql/init.sql
#
# The init script creates:
#   - Database: bindmanager (utf8mb4)
#   - User:     bindmanager@'%' with full privileges

# ── PostgreSQL-specific setup (when DB_ENGINE=postgresql) ─────────────────────
# Run once before first `docker compose up`:
#   psql -U postgres < docker/postgres/init.sql
#
# The init script creates:
#   - Role:     bindmanager
#   - Database: bindmanager (UTF8), owned by bindmanager

# ── Redis ──────────────────────────────────────────────────────────────────────
# If your Redis requires a password, include it in the URL:
#   REDIS_URL=redis://:<password>@host.docker.internal:6379/0
# Without password:
#   REDIS_URL=redis://host.docker.internal:6379/0
REDIS_PASSWORD=your-redis-password
REDIS_URL=redis://:your-redis-password@host.docker.internal:6379/0

# ── Reverse proxy ──────────────────────────────────────────────────────────────
# Number of proxies in front of the app (1 = the bundled nginx). Used to find
# the real client IP for the login lockout, API rate limits and the audit log.
# Only raise it if you put another proxy/load balancer in front of nginx.
# TRUSTED_PROXY_COUNT=1

# ── Personal API tokens ────────────────────────────────────────────────────────
# Longest expiry a user may pick for a personal API token (days). 0 also
# allows tokens that never expire (not recommended: BindManager isn't told
# when someone is disabled in Authentik/Okta).
# API_TOKEN_MAX_DAYS=90

# ── BIND ───────────────────────────────────────────────────────────────────────
# Zone file output directory (must match the volume mount in docker-compose.yml)
BIND_ZONES_DIR=/etc/bind/zones

# Optional: path to rndc binary inside the web/worker container
RNDC_BIN=/usr/sbin/rndc

# ── Let's Encrypt (DNS-01 via certbot) ───────────────────────────────────────────
# Dedicated BindManager account for the certbot DNS hook (docker/certbot/).
# Must have is_staff=True so it can create/delete records via the API.
# Do NOT reuse a personal admin login here.
ACME_API_USERNAME=
ACME_API_PASSWORD=

# ── Security ───────────────────────────────────────────────────────────────────
# Session lifetime in seconds. Default is 8 hours (28800). Reduce for higher-
# security environments; increase if users complain about frequent logouts.
# SESSION_COOKIE_AGE=28800

# ── Branding ───────────────────────────────────────────────────────────────────
# Drop logo.{svg,png,webp} and favicon.ico into ./branding/ and they are picked
# up automatically on next request — no rebuild needed.
# Use the env vars below only if you want to serve assets from an external URL
# (e.g. a CDN) instead of the volume-mounted files.
# BRANDING_APP_NAME=BindManager
# BRANDING_LOGO_URL=https://cdn.example.com/logo.png
# BRANDING_FAVICON_URL=https://cdn.example.com/favicon.ico

# ── SSO — Okta ─────────────────────────────────────────────────────────────────
# Set to true to show the Okta login button; backend is not loaded when false
OKTA_ENABLED=false
OKTA_BASE_URL=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=

# ── SSO — Authentik ────────────────────────────────────────────────────────────
# Set to true to show the Authentik login button
# AUTHENTIK_OIDC_ENDPOINT is the issuer URL from your Authentik provider config,
# e.g. https://auth.example.com/application/o/bindmanager/
AUTHENTIK_ENABLED=false
AUTHENTIK_OIDC_ENDPOINT=
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
