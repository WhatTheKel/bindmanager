# Copy to .env.agent on each nameserver host deploying docker-compose.agent.yml
# (a different file/host per NameServer row — the API key is what scopes
# which zones this particular node receives).
#
# Use this file/compose pair only on a host that ALREADY has BIND9 running
# — see docker/bind9-agent/README.md. For a fresh host with no BIND9
# install, use docker-compose.node.yml + .env.node.example instead.

# Base URL of BindManager's REST API (no trailing slash)
BINDMANAGER_API_URL=https://your-app-host/api/v1

# From Manage > Nameservers in the BindManager UI (or Django admin) for the
# NameServer row that represents THIS node. Treat like a password.
BINDMANAGER_API_KEY=REPLACE_ME

# Seconds between pulls
BINDMANAGER_POLL_INTERVAL=120

# Host-side paths bind-mounted into the container by docker-compose.agent.yml.
# Defaults match a stock Debian/Ubuntu bind9 install — uncomment and adjust
# only if this host's paths differ.
# BIND_ZONES_DIR=/etc/bind/zones
# BIND_RNDC_KEY=/etc/bind/rndc.key
# BIND_NAMED_CONF_INCLUDE=/etc/bind/named.bindmanager.conf
